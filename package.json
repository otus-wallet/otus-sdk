{
  "name": "@otus-wallet/sdk",
  "version": "0.1.1",
  "description": "Otus Wallet's transaction review for Solana: decode, simulate, explain and assess a transaction, and guard it with Lighthouse, on @solana/kit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otus-wallet/otus-sdk.git"
  },
  "homepage": "https://github.com/otus-wallet/otus-sdk",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codama/dynamic-codecs": "1.3.0",
    "@codama/nodes": "1.11.0",
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/visitors-core": "1.11.0",
    "@noble/hashes": "2.4.0",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/loader-v3": "0.7.0",
    "@solana-program/memo": "0.15.0",
    "@solana-program/stake": "0.10.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
